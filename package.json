{
  "name": "buckets",
  "private": true,
  "version": "0.0.0",
  "description": "Buckets monorepo root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 exec tsc --noEmit && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:desktop": "pnpm --filter @buckets/desktop tauri dev",
    "build:desktop": "pnpm --filter @buckets/desktop tauri build",
    "check:terminology": "tsx scripts/check-terminology.ts",
    "check:spdx": "tsx scripts/check-spdx.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "test:rust": "tsx scripts/run-rust-checks.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:terminology && pnpm check:spdx && pnpm check:licenses && pnpm test:coverage && pnpm test:rust"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.3.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
